+void quarry_profiled_scene_physics_queue_flush(CallQueue *p_queue) {
+	if (!quarry_queue_enabled() || quarry_queue_scope) {
+		p_queue->flush();
+		return;
+	}
+	QuarryQueueScope scope = { p_queue, false, quarry_queue_expand_names() };
+	quarry_queue_scope = &scope;
+	const uint32_t original_messages = quarry_queue_metrics.messages;
+	const uint64_t start = OS::get_singleton()->get_ticks_usec();
+	const Error status = p_queue->flush();
+	const uint64_t end = OS::get_singleton()->get_ticks_usec();
+	quarry_queue_scope = nullptr;
+	quarry_queue_metrics.flush_us += end >= start ? end - start : 0;
+	++quarry_queue_metrics.flushes;
+	quarry_queue_metrics.nonempty += quarry_queue_metrics.messages != original_messages;
+	quarry_queue_metrics.busy += status == ERR_BUSY;
+}
+
+void quarry_publish_scene_physics_queue_profile() {
+	if (!quarry_queue_metrics.flushes) {
+		return;
+	}
+	if (quarry_queue_enabled()) {
+		quarry_queue_metrics.publish(quarry_queue_expand_names());
+	}
+	quarry_queue_metrics.clear();
+}
