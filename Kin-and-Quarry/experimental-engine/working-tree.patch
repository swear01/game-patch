+		drain(nullptr);
+		return;
+	}
+	QuarryTransformBucket &bucket = quarry_transform_flush[quarry_transform_site];
+	quarry_transform_site = QUARRY_TRANSFORM_OTHER;
+	++bucket.flushes;
+	bucket.nested_flushes += quarry_transform_depth > 0;
+	++quarry_transform_depth;
+	const uint64_t begin = quarry_transform_stamp();
+	drain(&bucket);
+	bucket.inclusive_us += quarry_transform_stamp() - begin;
+	--quarry_transform_depth;
+#endif
