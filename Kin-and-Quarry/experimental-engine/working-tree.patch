+
+struct QuarrySignalKeyHasher {
+	static uint32_t hash(const QuarrySignalKey &p_key) {
+		return hash_murmur3_one_32(p_key.deferred, hash_murmur3_one_32(p_key.method.hash(),
+				hash_murmur3_one_32(p_key.path.hash(), p_key.type.hash())));
+	}
+};
