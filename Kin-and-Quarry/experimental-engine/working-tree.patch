+struct QuarrySignalTotals {
+	struct Bucket {
+		uint64_t us = 0;
+		uint32_t calls = 0;
+	};
+	HashMap<QuarrySignalKey, Bucket, QuarrySignalKeyHasher> callbacks;
+	Bucket overflow[2];
+	uint64_t elapsed = 0;
+	uint64_t snapshot = 0;
+	uint32_t emissions = 0;
+	uint32_t slots = 0;
+	uint32_t invalid = 0;
+
+	void add(const QuarrySignalKey &p_key, uint64_t p_us) {
+		Bucket *bucket = callbacks.getptr(p_key);
+		if (!bucket) {
+			bucket = callbacks.size() < 128 ? &callbacks.insert(p_key, Bucket{})->value : &overflow[p_key.deferred];
+		}
+		bucket->us += p_us;
+		bucket->calls++;
+	}
+
+	Array serialize() const {
+		Array rows;
+		for (const KeyValue<QuarrySignalKey, Bucket> &kv : callbacks) {
+			rows.append(Array{ kv.key.deferred, kv.key.type, kv.key.path, kv.key.method, kv.value.calls, kv.value.us });
+		}
+		for (int i = 0; i < 2; i++) {
+			if (overflow[i].calls) {
+				rows.append(Array{ bool(i), "<overflow>", "", "", overflow[i].calls, overflow[i].us });
+			}
+		}
+		return Array{ emissions, slots, invalid, elapsed, snapshot, rows };
+	}
+};
+
+struct QuarrySignalOrigin {
+	const Object *receiver;
+	QuarrySignalKey *key;
+};
+
+QuarrySignalTotals quarry_signals[4];
+// Arm only at the two native SceneTree calls, then consume at Object entry.
+// Nested emissions during callbacks are part of that callback's time.
+thread_local QuarrySignalTotals *quarry_next_signal = nullptr;
+thread_local QuarrySignalOrigin *quarry_signal_origin = nullptr;
+
+bool quarry_signals_enabled(bool p_timer) {
+	static const bool requested = OS::get_singleton()->get_environment("QUARRY_SCENE_FRAME_SIGNALS") == "1";
+	static const bool timers_requested = OS::get_singleton()->get_environment("QUARRY_SCENE_TIMER_SIGNALS") == "1";
+	return (p_timer ? timers_requested : requested) && EngineDebugger::is_active() && EngineDebugger::is_profiling(SNAME("servers"));
+}
+
+QuarrySignalKey quarry_get_signal_key(const Callable &p_callable, const Object *p_receiver, bool p_deferred) {
+	QuarrySignalKey key;
+	key.deferred = p_deferred;
+	const Callable *base = p_callable.get_base_comparator(); // Unwrap standard bind/unbind safely.
+	if (base->is_standard()) {
+		key.method = base->get_method();
+	} else {
+		key.method = SNAME("<custom>");
+#if defined(__cpp_rtti) || defined(_CPPRTTI)
+		// The generic CallableCustom::get_method() can log errors. Only ask
+		// the trusted native method-pointer type for its debug method name.
+		if (const auto *native = dynamic_cast<const CallableCustomMethodPointerBase *>(base->get_custom())) {
+			key.method = native->get_method();
+		}
+#endif
+	}
+	if (p_receiver) {
+		key.type = p_receiver->get_class_name();
+		if (ScriptInstance *instance = p_receiver->get_script_instance()) {
+			const Ref<Script> source = instance->get_script();
+			if (source.is_valid()) {
+				key.path = source->get_path();
+			}
+		} else if (const Script *source = Object::cast_to<Script>(p_receiver)) {
+			key.path = source->get_path();
+		}
+	} else {
+		key.type = SNAME("<no receiver>");
+	}
+	return key;
+}
+
+void quarry_timed_direct_signal(QuarrySignalTotals &p_totals, const Callable &p_callable, const Variant **p_args, int p_argc,
+		Variant &r_ret, Callable::CallError &r_error) {
+	const Object *receiver = p_callable.get_object();
+	QuarrySignalKey key = quarry_get_signal_key(p_callable, receiver, false);
+	QuarrySignalOrigin origin{ receiver, &key };
+	if (key.type == SNAME("GDScriptFunctionState") && key.method == SNAME("_signal_callback")) {
+		quarry_signal_origin = &origin;
+	}
+	const uint64_t start = OS::get_singleton()->get_ticks_usec();
+	p_callable.callp(p_args, p_argc, r_ret, r_error);
+	const uint64_t elapsed = OS::get_singleton()->get_ticks_usec() - start;
+	quarry_signal_origin = nullptr;
+	p_totals.add(key, elapsed);
+}
+
+void quarry_timed_deferred_signal(QuarrySignalTotals &p_totals, const Callable &p_callable, const Variant **p_args, int p_argc) {
+	const QuarrySignalKey key = quarry_get_signal_key(p_callable, p_callable.get_object(), true);
+	const uint64_t start = OS::get_singleton()->get_ticks_usec();
+	MessageQueue::get_singleton()->push_callablep(p_callable, p_args, p_argc, true);
+	p_totals.add(key, OS::get_singleton()->get_ticks_usec() - start);
+}
