+			case QuarryQueueKind::SET: return "set:" + String(method);
+			case QuarryQueueKind::NOTIFY: return "notify:" + itos(code);
+			case QuarryQueueKind::CUSTOM: return detail ? "custom:" + String(detail) : (method == StringName() ? String("custom:unnamed") : "custom:" + String(method));
+			case QuarryQueueKind::SKIPPED: return "skipped:" + itos(code);
+			case QuarryQueueKind::OTHER_BUCKET: return "overflow:other";
+		}
+		return "overflow:unexpected";
+	}
+};
