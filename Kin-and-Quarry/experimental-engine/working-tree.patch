+namespace {
+struct QuarryProcessPrefix {
+	struct Side {
+		int count = 0;
+		uint64_t epoch = 0;
+	};
+	Side idle;
+	Side physics;
+	std::atomic<uint64_t> reorder_epoch{ 0 };
+	bool activation_reported = false;
+
+	void reset() {
+		idle = Side();
+		physics = Side();
+		reorder_epoch.store(0, std::memory_order_relaxed);
