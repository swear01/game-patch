+struct QuarryQueueMetrics {
+	struct Bucket {
+		uint64_t us = 0;
+		uint32_t calls = 0;
+	};
+	HashMap<QuarryQueueKey, Bucket, QuarryQueueKey> methods;
+	Bucket overflow;
+	uint64_t flush_us = 0;
+	uint64_t dispatch_us = 0;
+	uint32_t messages = 0;
+	uint32_t flushes = 0;
+	uint32_t nonempty = 0;
+	uint32_t busy = 0;
+	// One random position per 32 eligible messages, not periodic sampling
+	// of one fixed position which could alias recurring per-step batches.
+	uint32_t sample_rng = 0xa31a8f35;
+	uint32_t sample_position = 0;
+	uint32_t sample_index = 0;
+
+	bool take_custom_name_sample() {
+		const uint32_t position = sample_position++ & 31;
+		if (position == 0) {
+			sample_rng ^= sample_rng << 13;
+			sample_rng ^= sample_rng >> 17;
+			sample_rng ^= sample_rng << 5;
+			sample_index = sample_rng & 31;
+		}
+		return position == sample_index;
+	}
+
+	void record(const QuarryQueueKey &p_key, uint64_t p_us) {
+		Bucket *row = methods.getptr(p_key);
+		if (!row) {
+			// Keep diagnostic work bounded, including pathological dynamic method keys.
+			row = methods.size() < 128 ? &methods[p_key] : &overflow;
+		}
+		row->us += p_us;
+		++row->calls;
+		dispatch_us += p_us;
+		++messages;
+	}
+
+	void publish(bool p_expand_names) {
+		Array times = { "scene_quarry_deferred_times", "@flush_total", flush_us * 0.000001, "@dispatch_total", dispatch_us * 0.000001 };
+		Array counts = { "scene_quarry_deferred_counts", "@flush_calls", double(flushes), "@nonempty_flushes", double(nonempty), "@busy_flushes", double(busy), "@messages", double(messages) };
+		auto append = [&](const String &p_label, const Bucket &p_row) {
+			times.append(p_label);
+			times.append(p_row.us * 0.000001);
+			counts.append(p_label);
+			counts.append(double(p_row.calls));
+		};
+		if (p_expand_names) {
+			// Literal identity is cheap per message. Merge equal texts from
+			// separate translation units once when the frame is published.
+			HashMap<String, Bucket> merged;
+			for (const KeyValue<QuarryQueueKey, Bucket> &entry : methods) {
+				Bucket &bucket = merged[entry.key.label()];
+				bucket.us += entry.value.us;
+				bucket.calls += entry.value.calls;
+			}
+			for (const KeyValue<String, Bucket> &entry : merged) {
+				append(entry.key, entry.value);
+			}
+		} else {
+			for (const KeyValue<QuarryQueueKey, Bucket> &entry : methods) {
+				append(entry.key.label(), entry.value);
+			}
+		}
+		if (overflow.calls) {
+			const QuarryQueueKey key = { QuarryQueueKind::OTHER_BUCKET, StringName(), 0 };
+			append(key.label(), overflow);
+		}
+		EngineDebugger::profiler_add_frame_data(SNAME("servers"), times);
+		EngineDebugger::profiler_add_frame_data(SNAME("servers"), counts);
+	}
+
+	void clear() {
+		methods.clear();
+		overflow = Bucket{};
+		flush_us = dispatch_us = 0;
+		messages = flushes = nonempty = busy = 0;
+	}
+};
