+struct QuarryQueueKey {
+	QuarryQueueKind kind = QuarryQueueKind::CUSTOM;
+	StringName method;
+	int code = 0;
+	const char *detail = nullptr; // static callable_mp text or explode receiver label
+
+	static uint32_t hash(const QuarryQueueKey &p_key) {
+		const uint32_t base = hash_murmur3_one_32(uint32_t(p_key.code), hash_murmur3_one_32(uint32_t(p_key.kind), p_key.method.hash()));
+		return p_key.detail ? hash_murmur3_one_64(reinterpret_cast<uintptr_t>(p_key.detail), base) : base;
+	}
