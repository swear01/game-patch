+#ifdef DEBUG_ENABLED
+namespace {
+
+struct QuarrySignalKey {
+	StringName type;
+	String path;
+	StringName method;
+	bool deferred = false;
+
+	bool operator==(const QuarrySignalKey &p_other) const {
+		return type == p_other.type && path == p_other.path && method == p_other.method && deferred == p_other.deferred;
+	}
