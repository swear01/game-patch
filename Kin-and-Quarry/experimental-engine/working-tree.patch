+
+void quarry_label_scene_frame_coroutine(const Object *p_state, const String &p_path, const StringName &p_function) {
+	QuarrySignalOrigin *origin = quarry_signal_origin;
+	if (origin && origin->receiver == p_state) {
+		origin->key->path = p_path;
+		origin->key->method = p_function;
+		quarry_signal_origin = nullptr;
+	}
+}
+
+void quarry_profile_scene_frame_signal(Object *p_tree, const StringName &p_signal, bool p_physics, bool p_timer) {
+	if (!Thread::is_main_thread() || !quarry_signals_enabled(p_timer)) {
+		p_tree->emit_signal(p_signal);
+		return;
+	}
+	QuarrySignalTotals &totals = quarry_signals[(p_timer ? 2 : 0) + (p_physics ? 0 : 1)];
+	totals.emissions++;
+	const uint64_t start = OS::get_singleton()->get_ticks_usec();
+	quarry_next_signal = &totals;
+	p_tree->emit_signal(p_signal);
+	quarry_next_signal = nullptr; // Also clear on blocked-signal early return.
+	totals.elapsed += OS::get_singleton()->get_ticks_usec() - start;
+}
+
+void quarry_publish_scene_frame_signals() {
+	for (int i = 0; i < 4; i += 2) {
+		const bool timer = i == 2;
+		if (quarry_signals[i].emissions || quarry_signals[i + 1].emissions || (timer && quarry_signals_enabled(true))) {
+			if (quarry_signals_enabled(timer)) {
+				const Array packet{ Engine::get_singleton()->get_process_frames(), quarry_signals[i].serialize(), quarry_signals[i + 1].serialize() };
+				print_line(String(timer ? "QUARRY_TIMER_SIGNAL " : "QUARRY_FRAME_SIGNAL ") + JSON::stringify(packet));
+			}
+			quarry_signals[i] = QuarrySignalTotals{};
+			quarry_signals[i + 1] = QuarrySignalTotals{};
+		}
+	}
+}
