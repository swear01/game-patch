+QuarryProcessPrefix quarry_process_prefix;
+
+bool quarry_process_prefix_enabled() {
+	static const bool enabled = OS::get_singleton()->get_environment("QUARRY_PROCESS_PREFIX_SORT") == "1";
+	return enabled;
+}
+
+// `nodes` only receives tail appends, stable erases and stock sorts. For a
+// small changed suffix, keep the existing sorted prefix and binary-insert
+// each new member using the exact stock comparator and stable pointer moves.
+template <typename Comparator>
+void quarry_insert_process_suffix(Node **p_nodes, int p_total, int p_prefix, Comparator p_less) {
+	for (int index = p_prefix; index < p_total; ++index) {
+		Node *node = p_nodes[index];
+		if (!p_less(node, p_nodes[index - 1])) {
+			continue;
+		}
+		int lo = 0;
+		int hi = index - 1;
+		while (lo < hi) {
+			const int middle = lo + (hi - lo) / 2;
+			if (p_less(node, p_nodes[middle])) {
+				hi = middle;
+			} else {
+				lo = middle + 1;
+			}
+		}
+		std::memmove(p_nodes + lo + 1, p_nodes + lo, size_t(index - lo) * sizeof(Node *));
+		p_nodes[lo] = node;
+	}
+}
+
+template <typename Comparator>
+void quarry_sort_process_prefix(Vector<Node *> &r_nodes, QuarryProcessPrefix::Side &r_side) {
+	const uint64_t epoch = quarry_process_prefix.reorder_epoch.load(std::memory_order_relaxed);
+	const int count = r_nodes.size();
+	const int appended = count - r_side.count;
+	if (r_side.epoch != epoch || r_side.count <= 0 || appended < 0 || appended > 16 || appended > count / 8) {
+		r_nodes.sort_custom<Comparator>();
+	} else if (appended > 0) {
+		quarry_insert_process_suffix(r_nodes.ptrw(), count, r_side.count, Comparator());
+		if (!quarry_process_prefix.activation_reported) {
+			quarry_process_prefix.activation_reported = true;
+			print_line("QUARRY_PROCESS_PREFIX_ACTIVE");
+		}
+	}
+	r_side.count = count;
+	r_side.epoch = epoch;
+}
+
+bool quarry_erase_process_prefix(Vector<Node *> &r_nodes, Node *p_node, QuarryProcessPrefix::Side &r_side) {
+	const int erased = r_nodes.find(p_node);
+	if (erased < 0) {
+		return false;
+	}
+	if (erased < r_side.count) {
+		--r_side.count;
+	}
+	r_nodes.remove_at(erased);
+	return true;
+}
